<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force WWW and HTTPS in one rule
  RewriteCond %{HTTP_HOST} !^www\. [NC,OR]
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://www.venturesnodes.com/$1 [L,R=301]

  # Fix Next.js Windows build bug for __PAGE__.txt prefetch files
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/__next\.([^\./]+)\.([^\./]+)\.__PAGE__\.txt$ $1/__next.$2/$3/__PAGE__.txt [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/__next\.([^\./]+)\.__PAGE__\.txt$ $1/__next.$2/__PAGE__.txt [L]

  # Only rewrite to index.php if ALL of these conditions are met:
  RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|mp4|webm|php)$ [NC]
  RewriteCond %{REQUEST_URI} !^/seo-admin [NC]
  RewriteCond %{REQUEST_URI} !^/_next [NC]
  RewriteCond %{REQUEST_URI} !^/index\.php$ [NC]
  RewriteRule ^(.*)$ index.php [QSA,L]

  # Custom 404 page generated by Next.js
  ErrorDocument 404 /404.html
</IfModule>
